<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light base, dark in values-night. A WebView's prefers-color-scheme (and so light-dark() in
         theme.css for appearance = "auto") follows this theme's isLightTheme on Android 13+. -->
    <style name="Theme.Deft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Deft.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">#121212</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
