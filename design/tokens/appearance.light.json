{
  "$description": "Light appearance: off-white surfaces, near-black labels, alpha steps. Status darkened for light surfaces.",
  "bg": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
  "bgGrouped": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.95, 0, 0] } },
  "bgElevated": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
  "label": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0] } },
  "label2": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.6 } },
  "label3": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.3 } },
  "label4": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.16 } },
  "fill": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.08 } },
  "fill2": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.12 } },
  "fill3": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.16 } },
  "fill4": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.2 } },
  "separator": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.12 } },
  "error": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.52, 0.2, 50] } },
  "warning": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.62, 0.15, 75] } },
  "success": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.5, 0.14, 150] } },
  "info": { "$type": "color", "$value": "{label2}" }
}
