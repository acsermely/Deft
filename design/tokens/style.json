{
  "$description": "Style tokens: the one hybrid style (DESIGN-SYSTEM-PROPOSAL 8.1). W3C design-tokens format. Generated by tools/deft-design (bun tools/deft-design/build.js) into deft-runtime/v1/tokens.css, ui/theme/Tokens.kt and docs/design/tokens.md. Edit here, never in the generated files.",
  "font": {
    "text": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
    "display": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] },
    "numeric": { "$type": "fontFamily", "$value": ["Doto", "Geist Mono", "ui-monospace", "monospace"] },
    "numericWeight": { "$type": "fontWeight", "$value": 650 },
    "faces": [
      { "family": "Geist", "file": "geist.woff2", "weight": "100 900" },
      { "family": "Geist Mono", "file": "geist-mono.woff2", "weight": "400 500" },
      { "family": "Doto", "file": "doto.woff2", "weight": "100 900", "unicodeRange": "U+0020,U+0025,U+002D-003A,U+0041-005A,U+00B0" }
    ]
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "28px" },
    "screen": { "$type": "dimension", "$value": "44px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "pad": { "$type": "dimension", "$value": "12px" },
  "type": {
    "largeTitle": { "$type": "typography", "$value": { "family": "text", "size": 34, "leading": 41, "weight": 700, "tracking": -0.4 } },
    "title1": { "$type": "typography", "$value": { "family": "display", "size": 28, "leading": 34, "weight": 700, "tracking": -0.3 } },
    "title2": { "$type": "typography", "$value": { "family": "display", "size": 22, "leading": 28, "weight": 700, "tracking": -0.2 } },
    "title3": { "$type": "typography", "$value": { "family": "display", "size": 20, "leading": 25, "weight": 600, "tracking": -0.1 } },
    "headline": { "$type": "typography", "$value": { "family": "text", "size": 17, "leading": 22, "weight": 600, "tracking": -0.2 } },
    "body": { "$type": "typography", "$value": { "family": "text", "size": 17, "leading": 22, "weight": 400, "tracking": -0.2 } },
    "callout": { "$type": "typography", "$value": { "family": "text", "size": 16, "leading": 21, "weight": 400, "tracking": -0.1 } },
    "subhead": { "$type": "typography", "$value": { "family": "text", "size": 15, "leading": 20, "weight": 400, "tracking": -0.1 } },
    "footnote": { "$type": "typography", "$value": { "family": "text", "size": 13, "leading": 18, "weight": 400, "tracking": 0 } },
    "caption": { "$type": "typography", "$value": { "family": "text", "size": 12, "leading": 16, "weight": 400, "tracking": 0 } },
    "labelMono": { "$type": "typography", "$value": { "family": "mono", "size": 11, "leading": 14, "weight": 500, "tracking": 0.88, "uppercase": true } }
  },
  "motion": {
    "spring": {
      "snappy": { "$type": "spring", "$value": { "dampingRatio": 1, "stiffness": 576, "duration": 280 } },
      "smooth": { "$type": "spring", "$value": { "dampingRatio": 1, "stiffness": 200, "duration": 560 } },
      "bouncy": { "$type": "spring", "$value": { "dampingRatio": 0.7, "stiffness": 144, "duration": 660 } }
    },
    "stepDot": { "$type": "custom", "$value": { "steps": 8, "position": "jump-end" } }
  },
  "material": {
    "barAlpha": { "$type": "number", "$value": 62 },
    "barAlphaReduced": { "$type": "number", "$value": 92 },
    "blur": { "$type": "dimension", "$value": "24px" },
    "blurSaturate": { "$type": "number", "$value": 1.7 },
    "rimAlpha": { "$type": "number", "$value": 0.22 },
    "rimTopAlpha": { "$type": "number", "$value": 0.18 }
  },
  "icon": {
    "stroke": { "$type": "number", "$value": 1.5 }
  },
  "separator": {
    "hairline": { "$type": "dimension", "$value": "0.5px" }
  },
  "accent": {
    "default": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.657, 0.179, 40.4] } }
  }
}
